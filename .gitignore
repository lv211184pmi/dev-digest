node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# MCP host registration (local, opt-in). Copy .mcp.json.example to .mcp.json
# when you want a host to launch mcp/. Committing it would make every clone
# spawn the server on session start; registering it is a per-developer choice.
.mcp.json

# planner → implementer handoff artifacts (transient; implementer deletes on success)
.claude/plans/
